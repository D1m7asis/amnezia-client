        set(CLIENT_DISPLAY_NAME "D1m7asis VPN")
        set(CLIENT_SERVICE_NAME "D1m7asisVPN-service")
        set(CLIENT_ORGANIZATION_NAME "D1m7asis.VPN")
        set(CLIENT_APP_INSTANCE_NAME "D1m7asisVPNInstance")
        set(CLIENT_KEYCHAIN_NAME "D1m7asisVPN-Keychain")
        set(CLIENT_IPC_NAME "D1m7asisVpnIpcInterface")
        set(CLIENT_ENABLE_APP_UPDATES 0)
    endif()
